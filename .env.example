# HAQ Environment Variables Template (Root)
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/haq_db?schema=public"

# Groq AI Assistant (API Secret - Backend only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Sarvam AI Voice Processing (API Secret - Backend only)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_STT_MODEL=saaras:v2

# CORS configuration for web / mobile apps
CORS_ORIGIN=*

# Session Cryptographic Secret (32+ characters random string)
SESSION_SECRET="your_cryptographically_secure_random_session_secret_32_chars_min"

# EAS Build ignore for mobile workspace
# Prevents system/cache files from entering the build archive

# System caches and OS files
Library/
**/Library/
.Trash/
**/.Trash/
.DS_Store
**/.DS_Store

# Browser caches
**/Chrome/Default/Cache/
**/Cache_Data/

# Dependencies (EAS installs fresh)
node_modules/
**/node_modules/

# Build artifacts
dist/
build/
web-build/
.expo/

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Logs
*.log

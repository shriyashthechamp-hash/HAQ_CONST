{
  "expo": {
    "name": "HAQ",
    "slug": "haq-benefits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#070A0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070A0F"
      },
      "package": "com.haq.benefits",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "haq",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "99d2cea5-bbd8-4c6c-8e30-2f7001e04787"
      }
    }
  }
}
